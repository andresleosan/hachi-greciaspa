# Example environment variables for Hachi & Grecia Spa (do NOT store secrets here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to connect local Firebase emulators (auth:9099, firestore:8080)
VITE_USE_FIREBASE_EMULATOR=false

# Firebase App Check — reCAPTCHA v3 site key (H4 rate limiting)
# Get from Firebase Console → Project Settings → App Check → Web app
# Leave empty to disable App Check (development / emulator)
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Other optional env
VITE_MAPS_API_KEY=
